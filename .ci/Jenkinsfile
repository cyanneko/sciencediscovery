// Pipeline for a self-hosted Jenkins whose worker kernel grants unprivileged
// user namespaces, so bubblewrap runs natively. Every layer the CodeArts
// pipeline runs, minus code check, runs here in one pass, and the UT tiers need
// no split: this worker can execute the sandbox tier directly.
//
// Every stage runs on an ephemeral agent container provisioned by a Docker
// Cloud, and that container holds no Docker socket: a layer runs its entry
// point in the agent itself rather than in containers it starts. Nothing in
// this file, and nothing a layer runs, can reach the Docker API.
//
// The container's shape — image, the three non-privileged sandbox allowances,
// the numeric identity, the cache mounts — belongs to the cloud template on the
// controller. The image is built from .ci/agent.Dockerfile outside this
// pipeline, so no stage needs a socket.
//
// Rules from .agents/skills/ci/SKILL.md that this file keeps:
//   * call the repository's own entry points; never build a second,
//     platform-specific test definition here
//   * never weaken a sandbox assertion to make the pipeline green
//   * for a merge request, test the integration result rather than the source
//     branch snapshot, and treat a conflict as a failed check
//
// Jenkins global environment variables it reads, all optional:
//   CI_REPO_URL, CI_NPM_REGISTRY, CI_PYPI_INDEX, CI_UV_PYTHON_MIRROR,
//   CI_CONDA_MIRROR, CI_BINARY_CACHE_URL, CI_RUN_PROXY,
//   CI_E2E_STACK_TIMEOUT_SECONDS,
//   CI_OBS_AK_CREDENTIAL_ID / CI_OBS_SK_CREDENTIAL_ID
//
// No machine path, private mirror or credential value is written into the
// repository.

String repoUrl() {
    return env.CI_REPO_URL ?: 'https://gitcode.com/openJiuwen/sciencediscovery.git'
}

// Every layer checks out for itself, from the revisions the Resolve stage
// pinned. Pinning matters: the layers start at slightly different moments, and
// re-resolving per layer would let the target branch move underneath them so
// that two layers tested different trees and the run meant nothing.
//
// For a merge request this rebuilds the integration result with the
// repository's own .ci/rebase-codearts-pr.sh, exactly as the CodeArts jobs do.
// The rebased commit is disposable and never pushed; a conflict fails the
// layer, which is the intended verdict.
String checkoutScript() {
    return '''
set -eu

# pnpm does not read npm_config_registry from the environment, and the
# repository's own .npmrc is a tracked file — editing it would trip the
# cleanliness assertion in .ci/rebase-codearts-pr.sh. The user-level file is the
# one place left that is both effective and out of the way.
if [ -n "${CI_NPM_REGISTRY:-}" ]; then
    printf 'registry=%s\\n' "$CI_NPM_REGISTRY" > "$HOME/.npmrc"
fi

git init -q .
git remote add origin "$CI_REPO_URL" 2>/dev/null || git remote set-url origin "$CI_REPO_URL"
git fetch -q --no-tags origin "+refs/heads/$CI_CHECKOUT_BRANCH:refs/remotes/origin/$CI_CHECKOUT_BRANCH"
git -c advice.detachedHead=false checkout -q --detach "$CI_CHECKOUT_SHA"

if [ -n "${CI_MR_ID:-}" ]; then
    git fetch -q --no-tags origin "+refs/merge-requests/$CI_MR_ID/head:refs/ci/merge-request"
    CI_CHECKOUT_METADATA_DIR="$CI_RESULTS_DIR/checkout" \\
        bash .ci/rebase-codearts-pr.sh "merge-request-$CI_MR_ID" "$CI_SOURCE_SHA"
fi
echo "under test: $(git rev-parse HEAD)  $(git show -s --format=%s)"
'''
}

// Publishing is diagnostics, never a verdict. It runs after the layer has
// recorded its exit code, so it cannot turn a red layer green; and a broken
// upload marks the build unstable rather than impersonating a test failure.
//
// The key layout is the one in
// .agents/skills/ci/references/codearts-obs.md: commit and run id both appear,
// so reruns of a commit cannot overwrite one another. The commit is the one
// actually tested — for a merge request that is the integration commit, not the
// source tip. The run id is prefixed to keep this worker's objects
// distinguishable from a CodeArts run.
void publishResults(String layer) {
    archiveArtifacts artifacts: '.tmp/ci-results/**', allowEmptyArchive: true
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE',
               message: "OBS upload for ${layer} failed") {
        withCredentials([
            string(credentialsId: env.CI_OBS_AK_CREDENTIAL_ID ?: 'codearts-obs-ak',
                   variable: 'OBS_ACCESS_KEY_ID'),
            string(credentialsId: env.CI_OBS_SK_CREDENTIAL_ID ?: 'codearts-obs-sk',
                   variable: 'OBS_SECRET_ACCESS_KEY'),
        ]) {
            sh label: "obs upload ${layer}", script: """
set -eu
if [ ! -d "\$CI_RESULTS_DIR" ]; then
    echo "obs-upload: \$CI_RESULTS_DIR does not exist, nothing to publish"
    exit 0
fi
# The uploader travels with the revision under test. A revision that predates it
# — any merge request branched before this landed on the target — simply has no
# uploader, which is worth saying plainly rather than failing on a missing file.
if [ ! -f .ci/obs-upload.py ]; then
    echo "obs-upload: this revision has no .ci/obs-upload.py; results stay in the build archive only"
    exit 0
fi
TESTED="\$(git rev-parse HEAD 2>/dev/null || echo unknown)"
uv run --script .ci/obs-upload.py \\
    --prefix "sciencediscovery/ci/\$TESTED/jenkins-\$BUILD_NUMBER" \\
    "\$CI_RESULTS_DIR"
"""
        }
    }
}

pipeline {
    // Nothing runs on the controller; each branch brings its own container.
    agent none

    options {
        // Each layer checks out for itself, from pinned revisions.
        skipDefaultCheckout()
        // The layer runtime directories under the shared cache are fixed names,
        // so two builds of this job cannot overlap.
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')
        timestamps()
    }

    parameters {
        string(
            name: 'MR_ID',
            defaultValue: '',
            description: 'GitCode merge request number. Set it to test that merge '
                       + 'request rebased onto TARGET_BRANCH. Leave empty to test '
                       + 'BRANCH as it stands.')
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Branch to test when MR_ID is empty.')
        string(
            name: 'TARGET_BRANCH',
            defaultValue: 'main',
            description: 'Branch a merge request is rebased onto.')
    }

    environment {
        CI_REPO_URL = "${repoUrl()}"

        // Dependency mirrors for the test layers. npm resolves from the
        // lockfile's integrity hashes, so a registry mirror is safe; uv cannot
        // use one here, because uv.lock pins both the index and the
        // files.pythonhosted.org URL of every wheel and uv sync --locked
        // refuses anything else. What has no mirror goes through the proxy,
        // which leaves the URLs and therefore the lock intact. NO_PROXY has to
        // cover loopback or the E2E stack's own health checks get proxied away.
        npm_config_registry = "${env.CI_NPM_REGISTRY ?: 'https://registry.npmjs.org/'}"
        HTTP_PROXY  = "${env.CI_RUN_PROXY ?: ''}"
        HTTPS_PROXY = "${env.CI_RUN_PROXY ?: ''}"
        http_proxy  = "${env.CI_RUN_PROXY ?: ''}"
        https_proxy = "${env.CI_RUN_PROXY ?: ''}"
        NO_PROXY    = 'localhost,127.0.0.1,::1'
        no_proxy    = 'localhost,127.0.0.1,::1'
    }

    stages {
        stage('Resolve revision') {
            agent { label 'ci-docker' }
            steps {
                script {
                    def mrId = params.MR_ID.trim()
                    def branch = (mrId ? params.TARGET_BRANCH : params.BRANCH).trim()
                    env.CI_MR_ID = mrId
                    env.CI_CHECKOUT_BRANCH = branch
                    env.CI_CHECKOUT_SHA = sh(
                        returnStdout: true,
                        label: "resolve ${branch}",
                        script: "git ls-remote \"\$CI_REPO_URL\" \"refs/heads/${branch}\" | cut -f1"
                    ).trim()
                    if (!env.CI_CHECKOUT_SHA) {
                        error("branch ${branch} does not exist in ${repoUrl()}")
                    }
                    if (mrId) {
                        env.CI_SOURCE_SHA = sh(
                            returnStdout: true,
                            label: "resolve merge request ${mrId}",
                            script: "git ls-remote \"\$CI_REPO_URL\" \"refs/merge-requests/${mrId}/head\" | cut -f1"
                        ).trim()
                        if (!env.CI_SOURCE_SHA) {
                            error("merge request ${mrId} has no head ref in ${repoUrl()}")
                        }
                        echo "merge request ${mrId}: source ${env.CI_SOURCE_SHA} onto ${branch} ${env.CI_CHECKOUT_SHA}"
                    } else {
                        echo "branch ${branch}: ${env.CI_CHECKOUT_SHA}"
                    }
                }
            }
        }

        // The layers are independent and share nothing writable except the
        // dependency caches, so they run concurrently. Each gets its own
        // container, workspace and checkout, and the container is discarded
        // afterwards.
        stage('Layers') {
            parallel {
                stage('UT') {
                    agent { label 'ci-docker' }
                    environment {
                        CI_RESULTS_DIR = "${WORKSPACE}/.tmp/ci-results"
                        CI_RUNTIME_DIR = '/ci-cache/runtime/ut'
                    }
                    steps {
                        sh label: 'checkout', script: checkoutScript()
                        // The aggregate entry point: the host tier followed by the
                        // guest tier. Both run here; the guest tier executes a real
                        // bubblewrap rather than a QEMU guest, which is the whole
                        // reason this worker exists.
                        sh 'mkdir -p "$CI_RUNTIME_DIR" && pnpm ci:ut'
                    }
                    post { always { publishResults('ut') } }
                }

                stage('ST') {
                    agent { label 'ci-docker' }
                    environment {
                        CI_RESULTS_DIR = "${WORKSPACE}/.tmp/ci-results"
                        CI_RUNTIME_DIR = '/ci-cache/runtime/st'
                    }
                    steps {
                        sh label: 'checkout', script: checkoutScript()
                        sh 'mkdir -p "$CI_RUNTIME_DIR" && pnpm ci:st'
                    }
                    post { always { publishResults('st') } }
                }

                stage('E2E (mocked)') {
                    agent { label 'ci-docker' }
                    environment {
                        CI_RESULTS_DIR = "${WORKSPACE}/.tmp/ci-results"
                        CI_RUNTIME_DIR = '/ci-cache/runtime/e2e'
                        CI_E2E_STACK_TIMEOUT_SECONDS = "${env.CI_E2E_STACK_TIMEOUT_SECONDS ?: '900'}"
                    }
                    steps {
                        sh label: 'checkout', script: checkoutScript()
                        // The workspace is fresh every build, but the runtime
                        // directory lives in the shared cache and is not. Without a
                        // reset, state leaks: journeys that assert an empty state
                        // find the previous build's providers and Skill library, and
                        // report a missing "no providers yet" panel or "Run this
                        // journey with fresh isolated Skill library data". envs/
                        // holds the service virtualenvs, whose editable installs
                        // record this checkout's path, and must survive.
                        //
                        // E2E_COMMIT_SHA gives journey reports an immutable revision.
                        // The first run provisions those virtualenvs and Chromium,
                        // which the default 180-second health wait does not cover;
                        // that shows up as "BLOCKED: isolated E2E stack did not
                        // become healthy".
                        sh label: 'pnpm ci:e2e', script: '''
set -eu
mkdir -p "$CI_RUNTIME_DIR"
if [ -d "$CI_RUNTIME_DIR/data" ]; then
    find "$CI_RUNTIME_DIR/data" -mindepth 1 -maxdepth 1 ! -name envs -exec rm -rf {} +
fi
E2E_COMMIT_SHA="$(git rev-parse HEAD)" pnpm ci:e2e
'''
                    }
                    post { always { publishResults('e2e') } }
                }

                // The packaging entry point verifies `uname -m` against the
                // requested architecture, so this worker can only produce the
                // x86_64 package. The aarch64 one still needs an ARM machine.
                stage('Binary x86_64') {
                    agent { label 'ci-docker' }
                    environment {
                        CI_RESULTS_DIR = "${WORKSPACE}/.tmp/ci-results"
                        // The binary layer embeds a Python runtime rather than
                        // resolving a lockfile, so unlike the test layers it can
                        // take a PyPI mirror.
                        CI_PYPI_INDEX            = "${env.CI_PYPI_INDEX ?: ''}"
                        UV_DEFAULT_INDEX         = "${env.CI_PYPI_INDEX ?: ''}"
                        UV_PYTHON_INSTALL_MIRROR = "${env.CI_UV_PYTHON_MIRROR ?: ''}"
                        MICROMAMBA_CONDA_MIRROR  = "${env.CI_CONDA_MIRROR ?: ''}"
                        CI_BINARY_CACHE_URL      = "${env.CI_BINARY_CACHE_URL ?: ''}"
                    }
                    steps {
                        sh label: 'checkout', script: checkoutScript()
                        sh label: 'package x86_64', script: '''
set -eu
mkdir -p "$CI_RESULTS_DIR"
# The packaging entry point insists its output sits below .ci-results/, so the
# artifacts are collected from there into the directory that gets published.
EXPECTED_COMMIT="$(git rev-parse HEAD)" \\
ARTIFACT_COMMIT="${CI_SOURCE_SHA:-$(git rev-parse HEAD)}" \\
    bash .ci/package-binary-codearts.sh \\
        --arch x86_64 \\
        --output .ci-results/binary-release-x86_64
mkdir -p "$CI_RESULTS_DIR/binary/x86_64"
cp -a .ci-results/binary-release-x86_64/. "$CI_RESULTS_DIR/binary/x86_64/"
'''
                    }
                    post { always { publishResults('binary-x86_64') } }
                }
            }
        }
    }
}
